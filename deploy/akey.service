# akey server systemd unit - TEMPLATE.
# The normal way to install is scripts/install-server.sh, which writes this
# same unit (kept in sync there as a heredoc) with HOST/PORT filled in:
#   curl -fsSL https://raw.githubusercontent.com/xxddccaa/akey/main/scripts/install-server.sh | sudo bash
# Manual install instead:
#   sudo install -m 0755 dist/akey-linux-amd64 /usr/local/bin/akey
#   sudo mkdir -p /usr/local/share/akey/dist && sudo cp dist/akey-* dist/SHA256SUMS /usr/local/share/akey/dist/
#   sudo cp deploy/akey.service /etc/systemd/system/   # then replace YOUR_IP and 8787 below
#   sudo systemctl daemon-reload && sudo systemctl enable --now akey
#   sudo akey info --data /var/lib/akey --host YOUR_IP --listen :8787   # panel URL, admin token, one-liners
# Ports below 1024 need CapabilityBoundingSet=/AmbientCapabilities=CAP_NET_BIND_SERVICE.
[Unit]
Description=akey - encrypted agent config server (API + web panel)
Documentation=https://github.com/xxddccaa/akey
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/akey serve --listen :8787 --data /var/lib/akey --dist /usr/local/share/akey/dist --host YOUR_IP
Restart=on-failure
RestartSec=3

# Unprivileged, throwaway user; /var/lib/akey is its private state dir.
DynamicUser=yes
StateDirectory=akey
StateDirectoryMode=0700
UMask=0077

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
